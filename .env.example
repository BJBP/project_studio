# Copy to .env and adjust. Ports only on 127.0.0.1.
STUDIO_PORT=8765
# Home Assistant as the browser reaches it (the server uses the stack network)
HA_PUBLIC_URL=http://127.0.0.1:8123
MQTT_WS_URL=ws://127.0.0.1:9001
STUDIO_DATA_DIR=../project_studio_data
STUDIO_SECRETS_DIR=~/.agents/secrets/project_studio
# Linux: your user and group ids (id -u, id -g) so the files the Studio writes stay yours.
STUDIO_UID=1000
STUDIO_GID=1000
