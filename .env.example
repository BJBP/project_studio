# Copy to .env and adjust (the launchers do it). Ports only on 127.0.0.1. The voice stack's settings (ports, AI model,
# COMPOSE_PROFILES for the local AI) are in stack/domotica-voz/.env.
STUDIO_PORT=8765
STUDIO_DATA_DIR=../project_studio_data
STUDIO_SECRETS_DIR=~/.agents/secrets/project_studio
# Linux: your user and group ids (id -u, id -g) so the files the Studio writes stay yours (the .sh launcher sets them).
STUDIO_UID=1000
STUDIO_GID=1000
