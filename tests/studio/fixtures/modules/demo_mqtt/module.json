{
  "id": "demo_mqtt",
  "name": "MQTT de prueba",
  "version": "1.0.0",
  "license": "MIT",
  "icon": "🧪",
  "parent": "conexiones",
  "description": "Conector de prueba: envía cada estado a «<id>/state».",
  "adds": {
    "connector": {
      "type": "demo_mqtt",
      "transport": "mqtt",
      "options": [
        { "key": "host", "type": "text", "default": "127.0.0.1", "required": true, "max_length": 253 },
        { "key": "port", "type": "number", "default": 1883, "required": true, "min": 1, "max": 65535 }
      ]
    }
  }
}
